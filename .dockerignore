.git
.gitignore
.gitmodules
installation.txt
license.txt
README.md
Mura_CMS_contribution_agreement.pdf
docker-compose.yml
docker-offline.yml
stack-review.yml
buddy.yml
travis.yml

# --- Container build assets ---
# The Dockerfile itself, nginx config and entrypoint script are needed in
# the build context so docker/Dockerfile's explicit COPYs can reach them,
# but the rest of docker/ (this README, any compose overrides someone adds
# here) is build/local-dev tooling, not application content - keep it out
# of the image that COPY . /var/www produces.
docker/
!docker/entrypoint.sh
!docker/nginx/
!docker/nginx/default.conf
!docker/lucee/
!docker/lucee/merge-cfconfig.py
!docker/lucee/cfconfig.d/
!docker/lucee/cfconfig.d/*.json
.env
.env.example

# Legacy Lucee 5 / blueriver-era docker material - superseded by /docker,
# kept in the repo for reference only.
core/docker

# Test suite: not required to run Mura, so it's left out to keep the
# published base image smaller. Re-add here if a project wants
# `box testbox run` to work inside the container itself.
core/tests

# --- Runtime-generated content (mirrors .gitignore) ---
# Mura writes all of these on first boot, so a checkout that has run the
# compose stack has them lying around - and config/settings.ini.cfm carries
# the encryption key and datasource of whatever ran last. None of it belongs
# in an image; the Dockerfile recreates the directories it needs.
config/settings.ini.cfm
config/cfapplication.cfm
config/mappings.cfm
config/applicationSettings.cfm
config/settings.cfm
config/version.cfm
config/appcfc
config/setup
plugins/
sites/default/assets/
sites/default/cache/
sites/default/remote/
sites/default/Application.cfc
sites/default/contentRenderer.cfc
sites/default/eventHandler.cfc
sites/default/email/
sites/default/model/
themes/default/

# --- Build artefacts / dependency caches ---
node_modules
*.zip
*.log
logs/

# --- Never ship server/admin-only directories into an image build ---
WEB-INF/
CFIDE/

