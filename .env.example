# Copy this file to .env (which is git-ignored) and fill in real values
# before running `docker compose up`. Everything here is read by
# docker-compose.yml; none of it is baked into the image itself.
#
# These are LOCAL DEVELOPMENT defaults only. Do not reuse them anywhere
# real - see docker/README.md for production guidance.

# MSSQL "sa" password. Must satisfy SQL Server's complexity policy
# (8+ chars, upper+lower+digit or symbol) or the mssql container will exit.
MSSQL_SA_PASSWORD=Ch4ngeMe_NotForProd!

# Lucee server administrator password.
LUCEE_ADMIN_PASSWORD=Ch4ngeMe_NotForProd!

# Mura CMS admin account created by the unattended setup on first boot.
MURA_ADMIN_USERNAME=admin
MURA_ADMIN_PASSWORD=Ch4ngeMe_NotForProd!
MURA_ADMINEMAIL=admin@vintagetravel.co.uk

# Shared secret used to authorise ?appreload requests. Change per environment.
MURA_APPRELOADKEY=appreload

# REQUIRED. The key Mura encrypts plugin settings and stored credentials with.
# Any value works for a fresh dev database; a restored database needs the key
# it was written with. If it is left empty Mura generates one and persists it
# to config/settings.ini.cfm (and logs a warning), but a key that lives only
# in a container cannot be relied on to survive the container - so set it.
# Generate one with e.g.:  openssl rand -base64 24
MURA_ENCRYPTIONKEY=dev-only-not-a-secret-change-me

# Mura's mode: development (default here) or production. Both work on a clean
# database. development turns off the site-domain redirect, re-creates plugin
# display objects per request and shows debugging output; production is what
# a deployed site runs.
MURA_MODE=development

# Whether Lucee re-reads a .cfm/.cfc you have edited: once (default; checks the
# file's timestamp once per request, so bind-mounted edits show up on the next
# request), always, never (production: deploy by rebuilding), auto (Lucee's
# stock behaviour, under which edits were NOT picked up without a restart).
LUCEE_INSPECT_TEMPLATE=once

# Host port the mura container's :80 is published on. docker-compose.yml also
# passes it to Mura as MURA_PORT (the `port` ini key): Mura stores a site's
# domain WITHOUT a port and appends MURA_PORT when it builds absolute URLs, so
# the two must agree or links point at the wrong port. The unattended setup
# records the default site's domain as "localhost" from the entrypoint's
# warm-up request (MURA_WARMUP_HOST), so http://localhost:<MURA_HTTP_PORT>/ is
# the URL to use. See docker/README.md.
MURA_HTTP_PORT=80

# Host port (loopback only) for direct Tomcat/Lucee access, used to reach the
# Lucee server administrator at http://localhost:8888/lucee/admin/server.cfm.
# nginx blocks /lucee on the main port by design.
LUCEE_ADMIN_PORT=8888

# Host port (loopback only) SQL Server is published on, for SSMS / Azure Data
# Studio / sqlcmd. Change it if something else already owns 1433 locally.
MSSQL_PORT=1433
